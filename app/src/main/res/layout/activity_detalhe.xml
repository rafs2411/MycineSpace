<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgFundo"
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:alpha="0.45"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="380dp"
                android:background="@drawable/bg_gradiente_topo" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="64dp"
                android:paddingEnd="24dp"
                android:paddingBottom="40dp">

                <com.example.mycinespace.PosterImageView
                    android:id="@+id/imgPoster"
                    android:layout_width="140dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_poster"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop" />

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnJaAssisti"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_botao_contorno"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/detalhe_ja_assisti"
                        android:textAllCaps="false"
                        android:textColor="#EBB65F"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnQueroAssistir"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_botao_contorno"
                        android:minWidth="48dp"
                        android:minHeight="48dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="@string/detalhe_quero_assistir"
                        android:textAllCaps="false"
                        android:textColor="#EBB65F"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSinopse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:alpha="0.9"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="@string/detalhe_direcao"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvDirecao"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alpha="0.9"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="@string/detalhe_roteiristas"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRoteiristas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alpha="0.9"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="wrap_content"
                        android:text="@string/detalhe_estrelas"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvEstrelas"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:alpha="0.9"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/detalhe_trailer"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/cardTrailer"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_poster"
                    android:clickable="true"
                    android:clipToOutline="true"
                    android:contentDescription="@string/detalhe_trailer_desc"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/imgTrailer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:alpha="0.55"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/btnPlayTrailer"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_nav_ativo"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:text="@string/detalhe_play"
                        android:textColor="#30251B"
                        android:textSize="22sp" />

                    <WebView
                        android:id="@+id/webViewTrailer"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvDicaTrailer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/detalhe_trailer_dica"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvAbrirYoutube"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:text="@string/detalhe_abrir_youtube"
                    android:textColor="@color/link_blue"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/secaoAvaliacao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/detalhe_sua_avaliacao"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/modoEdicao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <RatingBar
                            android:id="@+id/ratingBar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:numStars="5"
                            android:progressBackgroundTint="#4A4A4A"
                            android:progressTint="#EBB65F"
                            android:rating="0"
                            android:secondaryProgressTint="#EBB65F"
                            android:stepSize="1" />

                        <TextView
                            android:id="@+id/tvNota"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/text_hint"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/etComentario"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_input"
                            android:gravity="top|start"
                            android:hint="@string/detalhe_comentario_hint"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine|textCapSentences"
                            android:maxLength="500"
                            android:minHeight="130dp"
                            android:padding="16dp"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_hint"
                            android:textSize="14sp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btnSalvarAvaliacao"
                            android:layout_width="200dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/bg_botao_cheio"
                            android:minHeight="48dp"
                            android:text="@string/detalhe_salvar"
                            android:textAllCaps="false"
                            android:textColor="#30251B"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/modoSalvo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <RatingBar
                            android:id="@+id/ratingBarSalva"
                            style="?android:attr/ratingBarStyleIndicator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:isIndicator="true"
                            android:numStars="5"
                            android:progressBackgroundTint="#4A4A4A"
                            android:progressTint="#EBB65F"
                            android:secondaryProgressTint="#EBB65F"
                            android:stepSize="1" />

                        <TextView
                            android:id="@+id/tvComentarioSalvo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:alpha="0.95"
                            android:lineSpacingExtra="3dp"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/detalhe_toque_editar"
                                android:textColor="@color/text_hint"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/tvExcluir"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:minWidth="48dp"
                                android:minHeight="48dp"
                                android:paddingStart="12dp"
                                android:paddingEnd="4dp"
                                android:text="@string/detalhe_excluir"
                                android:textColor="#E57373"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
        </FrameLayout>
    </ScrollView>

    <TextView
        android:id="@+id/btnVoltar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:clickable="true"
        android:contentDescription="@string/detalhe_voltar"
        android:focusable="true"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/detalhe_seta_voltar"
        android:textColor="@color/text_primary"
        android:textSize="36sp" />
</FrameLayout>
